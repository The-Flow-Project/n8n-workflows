# .env for the LOCAL / no-domain deployment (docker-compose.n8n.local.yml)
# Copy to .env and adjust. Services are reached by the server's LAN IP over plain HTTP.

# The Docker host's LAN IP — what browsers on the network connect to.
# Give the host a static or DHCP-reserved address so it does not change.
SERVER_IP=192.168.10.50

# --- n8n ---
ENCRYPTION_KEY=<your-encryption-key>   # create with `openssl rand -hex 32`
GENERIC_TIMEZONE=Europe/Berlin

# --- Garage ---
GARAGE_RPC_SECRET=<random-hex>              # create with `openssl rand -hex 32`
GARAGE_ADMIN_TOKEN=<random-base64>          # create with `openssl rand -base64 32`
GARAGE_METRICS_TOKEN=<random-base64>        # create with `openssl rand -base64 32`
GARAGE_ACCESS_KEY=<your-garage-access-key>
GARAGE_SECRET_KEY=<your-garage-secret-key>  # create with `openssl rand -hex 32`
BUCKET_NAME=uploads

# --- Outbound mail — only needed if you apply docker-compose.mailserver.local.yml
# (self-hosted mail relay). Not required otherwise; workflows can send mail via a node
# credential instead (Mailjet, Gmail — see ../README.md). If used: for the sender
# address / DKIM of outgoing mail only — NOT for web access. Can stay your real domain
# even though nothing is reachable by domain here. ---
DOMAIN_NAME=flow-project.net
SUBDOMAIN_MAIL=mail
SMTP_SENDER=noreply
DKIM_SELECTOR=mail
