# .env for the LOCAL / no-domain deployment (docker-compose.n8n.local.yml)
# Copy to .env and adjust. Services are reached by the server's LAN IP over plain HTTP.

# The Docker host's LAN IP — what browsers on the network connect to.
# Give the host a static or DHCP-reserved address so it does not change.
SERVER_IP=192.168.10.50

# --- n8n ---
ENCRYPTION_KEY=<your-encryption-key>   # create with `openssl rand -hex 32`
GENERIC_TIMEZONE=Europe/Berlin

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<your-minio-password>
BUCKET_NAME=uploads

# --- Outbound mail ---
# Only used for the sender address / DKIM of outgoing mail — NOT for web access.
# Can stay your real domain even though nothing is reachable by domain here.
DOMAIN_NAME=flow-project.net
SUBDOMAIN_MAIL=mail
SMTP_SENDER=noreply
