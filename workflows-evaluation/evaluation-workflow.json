{
  "name": "Evaluation Pipeline",
  "nodes": [
    {
      "parameters": {
        "content": "## Hugging Face Evaluation Pipeline\n1. Form or API POSTs JSON to this webhook\n2. Evaluation API is called at /evaluation/hf/start\n3. Status is polled every 30s\n4. Email sent on success/failure\n\nThe service evaluates inference output from a HuggingFace dataset and writes back evaluation statistics.\n\n## Credentials setup (required)\nImporting this workflow is not enough — every Header Auth field below is left unassigned on purpose and must be created and linked in the n8n UI before this workflow will run:\n- Webhook node -> use the shared \"Webhook API Key\" credential (the same one across every Flow form). This is the only key you ever hand to your users.\n- POST/GET nodes -> use an \"Inference Service API Key\" credential, whose value must match the API_KEY set in service-trocr-inference's own .env file. You need to know that value yourself; never share it with users.",
        "height": 480,
        "width": 460
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "a69c5f1e-3541-4db3-9730-b934e03efb7f",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evaluation-start",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "ignoreBots": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        304
      ],
      "id": "98d54a04-3db5-45e1-8054-9e7aa4350b13",
      "name": "Webhook: Receive Evaluation Request",
      "webhookId": "evaluation-webhook"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"accepted\", \"message\": \"Evaluation started. You will receive an email when it is done.\" }",
        "options": {
          "responseCode": 202
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        224,
        208
      ],
      "id": "225161b8-9880-4b56-8908-4218f2c84371",
      "name": "Respond: 202 Accepted"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-params",
              "name": "params",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        400
      ],
      "id": "42165513-3faf-48fb-a690-379c9f8079ff",
      "name": "Build Evaluation Params"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://service-trocr-inference:8000/evaluation/hf/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "huggingface_repo_name",
              "value": "={{ $json.params.huggingface_repo_name }}"
            },
            {
              "name": "huggingface_token",
              "value": "={{ $json.params.huggingface_token }}"
            },
            {
              "name": "splits",
              "value": "={{ $json.params.splits ?? ['test'] }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        400
      ],
      "id": "4d5cf86f-1ce5-42df-be20-9980cf85df6c",
      "name": "POST: Start Evaluation"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-process-id",
              "name": "process_id",
              "value": "={{ $json.request_id ?? $json.process_id ?? $json.id ?? $json.job_id }}",
              "type": "string"
            },
            {
              "id": "assign-notify-email",
              "name": "notify_email",
              "value": "={{ $('Webhook: Receive Evaluation Request').item.json.body.notify_email }}",
              "type": "string"
            },
            {
              "id": "assign-repo-name",
              "name": "repo_name",
              "value": "={{ $('Webhook: Receive Evaluation Request').item.json.body.huggingface_repo_name }}",
              "type": "string"
            },
            {
              "id": "assign-splits",
              "name": "splits",
              "value": "={{ $('Webhook: Receive Evaluation Request').item.json.body.splits }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        672,
        400
      ],
      "id": "3713323b-30c5-46a0-8974-80c0744eb73c",
      "name": "Extract Job ID & Email"
    },
    {
      "parameters": {
        "amount": 30
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        896,
        400
      ],
      "id": "a8b0e7a7-6e77-41f1-ad7a-49ce3408fb81",
      "name": "Wait 30s",
      "webhookId": "638cd781-8111-42ce-8622-ae076f940c2a"
    },
    {
      "parameters": {
        "url": "=http://service-trocr-inference:8000/evaluation/status/{{ $json.process_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        336
      ],
      "id": "4f33e41e-f58d-4038-a444-5bc0d524aede",
      "name": "GET: Check Status"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "merge-process-id",
              "name": "process_id",
              "value": "={{ $('Extract Job ID & Email').item.json.process_id }}",
              "type": "string"
            },
            {
              "id": "merge-notify-email",
              "name": "notify_email",
              "value": "={{ $('Extract Job ID & Email').item.json.notify_email }}",
              "type": "string"
            },
            {
              "id": "merge-repo-name",
              "name": "repo_name",
              "value": "={{ $('Extract Job ID & Email').item.json.repo_name }}",
              "type": "string"
            },
            {
              "id": "merge-splits",
              "name": "splits",
              "value": "={{ $('Extract Job ID & Email').item.json.splits }}",
              "type": "array"
            },
            {
              "id": "merge-status",
              "name": "status",
              "value": "={{ $json.state ?? $json.status }}",
              "type": "string"
            },
            {
              "id": "merge-error-message",
              "name": "error_message",
              "value": "={{ $json.error_message ?? $json.error ?? '' }}",
              "type": "string"
            },
            {
              "id": "merge-runtime",
              "name": "runtime",
              "value": "={{ $json.runtime ?? $json.duration ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-total-items",
              "name": "total_items",
              "value": "={{ $json.total_items ?? $json.total_lines ?? $json.total_pages ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-result-url",
              "name": "result_url",
              "value": "={{ $json.result_url ?? ('https://huggingface.co/datasets/' + $('Extract Job ID & Email').item.json.repo_name) }}",
              "type": "string"
            },
            {
              "id": "merge-metrics",
              "name": "metrics",
              "value": "={{ $json.metrics ?? $json.result ?? $json.results ?? {} }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1344,
        336
      ],
      "id": "daafb0ae-f9b8-426d-a1ea-342845de2dd6",
      "name": "Merge Status Context"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-not-in-progress",
              "leftValue": "={{ $json.status }}",
              "rightValue": "in_progress",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-not-pending",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-not-started",
              "leftValue": "={{ $json.status }}",
              "rightValue": "started",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1568,
        400
      ],
      "id": "5812a49e-f23d-42ec-a84a-84ac29461cdd",
      "name": "Job finished?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1792,
        400
      ],
      "id": "a6775586-87f1-4cd1-9db1-2d353b6d0ee7",
      "name": "Success or Failure?"
    },
    {
      "parameters": {
        "fromEmail": "noreply@flow-project.net",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "=Evaluation complete: {{ $json.repo_name }}",
        "emailFormat": "both",
        "text": "=Evaluation finished successfully\n\nDataset: {{ $json.repo_name }}\nSplits: {{ JSON.stringify($json.splits) }}\nJob ID: {{ $json.process_id }}\nItems evaluated: {{ $json.total_items }}\nRuntime: {{ $json.runtime }}s\n\nResult URL: {{ $json.result_url }}\n\nMetrics:\n{{ JSON.stringify($json.metrics, null, 2) }}\n\n----\nSent by the Flow evaluation pipeline.",
        "html": "=<h2>Evaluation finished successfully</h2><ul><li><strong>Dataset:</strong> {{ $json.repo_name }}</li><li><strong>Splits:</strong> {{ JSON.stringify($json.splits) }}</li><li><strong>Job ID:</strong> {{ $json.process_id }}</li><li><strong>Items evaluated:</strong> {{ $json.total_items }}</li><li><strong>Runtime:</strong> {{ $json.runtime }}s</li></ul><p>Result URL: <a href=\"{{ $json.result_url }}\">{{ $json.result_url }}</a></p><h3>Metrics</h3><pre>{{ JSON.stringify($json.metrics, null, 2) }}</pre><hr><p><small>Sent by the Flow evaluation pipeline.</small></p>",
        "options": {
          "appendAttribution": false
        }
      },
