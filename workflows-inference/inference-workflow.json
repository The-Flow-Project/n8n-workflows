          "id": "fTo5NQ0AqGDZE5U6",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"accepted\", \"message\": \"Inference started. You will receive an email when it is done.\" }",
        "options": {
          "responseCode": 202
        }
      },
