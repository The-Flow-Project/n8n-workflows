    {
      "parameters": {
        "method": "POST",
        "url": "http://service-trocr-inference:8000/inference/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "upload_repo_name",
              "value": "={{ $json.params.upload_repo_name }}"
            },
            {
              "name": "private_repo",
              "value": "={{ $json.params.private_repo === true || $json.params.private_repo === 'true' }}"
            },
            {
              "name": "trocr_model",
              "value": "={{ $json.params.trocr_model ?? 'microsoft/trocr-small-handwritten' }}"
            },
            {
              "name": "target_image_size",
              "value": "={{ $json.params.target_image_size ?? null }}"
            },
            {
              "name": "splits",
              "value": "={{ $json.params.splits ?? ['train'] }}"
            },
            {
              "name": "upload_mode",
              "value": "={{ $json.params.upload_mode ?? 'new_repo' }}"
            },
            {
              "name": "allow_source_repo_update",
              "value": "={{ $json.params.allow_source_repo_update === true || $json.params.allow_source_repo_update === 'true' }}"
            },
            {
              "name": "huggingface_token",
              "value": "={{ $json.params.huggingface_token }}"
            },
            {
              "name": "source_repo_name",
