{
  "name": "Garage Upload Cleanup",
  "nodes": [
    {
      "parameters": {
        "content": "## Garage Upload Cleanup\nRuns every Monday at 02:00.\nLists all objects in the **uploads** bucket and deletes\nany file whose LastModified date is older than 7 days.",
        "height": 140,
        "width": 380
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "id": "c907cd26-d91f-484d-9740-2bd10923d9f8",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * 1"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        208,
        272
      ],
      "id": "6f27b1b4-4fe0-4bce-8596-b0687aa36e97",
      "name": "Every Monday 02:00"
    },
    {
      "parameters": {
        "operation": "getAll",
        "bucketName": "uploads",
        "returnAll": true,
        "options": {}
      },
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        448,
        272
      ],
      "id": "4fca8e9f-149b-41aa-abf9-af366defe8f9",
      "name": "S3: List All Objects",
      "credentials": {
        "s3": {
          "id": "8JAgVdOvCMvRgyH6",
          "name": "S3 account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-older-than-7d",
              "leftValue": "={{ new Date($json.LastModified) < new Date(Date.now() - 7 * 24 * 60 * 60 * 1000) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        688,
        272
      ],
      "id": "3844ec67-4101-4bb9-9a30-e67f87c0b7f2",
      "name": "Older than 7 days?"
    },
    {
      "parameters": {
        "operation": "delete",
        "bucketName": "uploads",
        "fileKey": "={{ $json.Key }}",
        "options": {}
      },
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [
        928,
        112
      ],
      "id": "0d8877b3-26dc-4aba-a2c5-9a7070590cf6",
      "name": "S3: Delete Object",
      "credentials": {
        "s3": {
          "id": "8JAgVdOvCMvRgyH6",
          "name": "S3 account"
        }
      }
    }
  ],
