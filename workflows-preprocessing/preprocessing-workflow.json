        ]
      ]
    },
    "Has uploaded ZIP?": {
      "main": [
        [{ "node": "Upload ZIP to MinIO", "type": "main", "index": 0 }],
        [{ "node": "Set URL from Form Field", "type": "main", "index": 0 }]
      ]
    },
    "Upload ZIP to MinIO": {
      "main": [
        [{ "node": "Set URL from Upload", "type": "main", "index": 0 }]
      ]
    },
    "Set URL from Upload": {
      "main": [
        [{ "node": "POST: Start Preprocessing", "type": "main", "index": 0 }]
      ]
    },
    "Set URL from Form Field": {
      "main": [
        [{ "node": "POST: Start Preprocessing", "type": "main", "index": 0 }]
      ]
    },
    "POST: Start Preprocessing": {
