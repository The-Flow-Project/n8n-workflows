    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"accepted\", \"message\": \"Preprocessing started. You will receive an email when it is done.\" }",
        "options": {
          "responseCode": 202
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        14112,
        3728
      ],
