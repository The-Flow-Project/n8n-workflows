{
  "name": "Preprocessing Pipeline",
  "nodes": [
    {
      "parameters": {
        "content": "## Preprocessing Pipeline\n1. Form POSTs multipart to this webhook\n2. ZIP is uploaded to MinIO or a ZIP-URL is passed through\n3. Preprocessing API is called\n4. Status is polled every 30s\n5. Email sent on success/failure",
        "height": 160,
        "width": 340
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-200, -120],
      "id": "note-main",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "preprocess",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": { "ignoreBots": true }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 100],
      "id": "webhook-entrypoint",
      "name": "Webhook: Receive Form",
      "webhookId": "a7100e1a-5596-44af-845b-916049d7497f",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kcn7idWScWNelfTA",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"status\": \"accepted\", \"message\": \"Preprocessing started. You will receive an email when it is done.\" }",
        "options": { "responseCode": 202 }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [240, -60],
      "id": "respond-accepted",
      "name": "Respond: 202 Accepted"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-has-file",
              "leftValue": "={{ $binary?.zipfile !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [240, 200],
      "id": "if-has-file",
      "name": "Has uploaded ZIP?"
    },
    {
      "parameters": {
        "operation": "upload",
        "bucketName": "preprocessing-uploads",
        "fileName": "={{ $now.toFormat('yyyy-MM-dd-HH-mm') }}-{{ $binary.zipfile.fileName }}",
        "binaryPropertyName": "zipfile",
        "additionalFields": {},
        "tagsUi": { "tagsValues": [] }
      },
      "type": "n8n-nodes-base.s3",
      "typeVersion": 1,
      "position": [480, 80],
      "id": "s3-upload",
      "name": "Upload ZIP to MinIO",
      "credentials": {
        "s3": {
          "id": "8JAgVdOvCMvRgyH6",
          "name": "S3 account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-zip-url-from-minio",
              "name": "resolved_zip_url",
              "value": "=https://minio.flow-project.net/preprocessing-uploads/{{ $json.key }}",
              "type": "string"
            },
            {
              "id": "assign-params-from-upload",
              "name": "params",
              "value": "={{ $('Webhook: Receive Form').item.json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 80],
      "id": "set-url-from-upload",
      "name": "Set URL from Upload"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-zip-url-passthrough",
              "name": "resolved_zip_url",
              "value": "={{ $json.body.zip_url }}",
              "type": "string"
            },
            {
              "id": "assign-params-passthrough",
              "name": "params",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 340],
      "id": "set-url-passthrough",
      "name": "Set URL from Form Field"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://preprocessing.flow-project.net/preprocess/zip",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ (() => { const p = $json.params; const body = { huggingface_target_repo_name: p.huggingface_target_repo_name, huggingface_target_repo_private: p.huggingface_target_repo_private === 'true', append: p.append === 'true', export_mode: p.export_mode, crop: p.crop === 'true', allow_empty_lines: p.allow_empty_lines === 'true', batch_size: parseInt(p.batch_size), segment: p.segment, segmenter_config: JSON.stringify({ model_names: p.segmenter_model_names, batch_sizes: parseInt(p.segmenter_batch_sizes), load_existing_segmentation: p.load_existing_segmentation === 'true' }), huggingface_token: p.huggingface_token, zip_url: $json.resolved_zip_url }; if (p.augmentation_loops !== undefined) body.augmentation_loops = parseInt(p.augmentation_loops); if (p.min_width_line !== undefined) body.min_width_line = parseInt(p.min_width_line); if (p.min_height_line !== undefined) body.min_height_line = parseInt(p.min_height_line); if (p.split_train_ratio !== undefined) body.split_train_ratio = parseFloat(p.split_train_ratio); if (p.split_seed !== undefined) body.split_seed = parseInt(p.split_seed); if (p.split_shuffle !== undefined) body.split_shuffle = p.split_shuffle === 'true'; return body; })() }}",
        "options": { "timeout": 30000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 200],
      "id": "http-start-job",
      "name": "POST: Start Preprocessing",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kcn7idWScWNelfTA",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-process-id",
              "name": "process_id",
              "value": "={{ $json.request_id ?? $json.process_id ?? $json.id ?? $json.job_id }}",
              "type": "string"
            },
            {
              "id": "assign-notify-email",
              "name": "notify_email",
              "value": "={{ $('Webhook: Receive Form').item.json.body.notify_email }}",
              "type": "string"
            },
            {
              "id": "assign-repo-name",
              "name": "repo_name",
              "value": "={{ $('Webhook: Receive Form').item.json.body.huggingface_target_repo_name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1200, 200],
      "id": "set-job-context",
      "name": "Extract Job ID & Email"
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1440, 200],
      "id": "wait-30s",
      "name": "Wait 30s"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://preprocessing.flow-project.net/status/{{ $json.process_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": { "timeout": 15000 }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1680, 200],
      "id": "http-check-status",
      "name": "GET: Check Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Kcn7idWScWNelfTA",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "merge-process-id",
              "name": "process_id",
              "value": "={{ $('Extract Job ID & Email').item.json.process_id }}",
              "type": "string"
            },
            {
              "id": "merge-notify-email",
              "name": "notify_email",
              "value": "={{ $('Extract Job ID & Email').item.json.notify_email }}",
              "type": "string"
            },
            {
              "id": "merge-repo-name",
              "name": "repo_name",
              "value": "={{ $('Extract Job ID & Email').item.json.repo_name }}",
              "type": "string"
            },
            {
              "id": "merge-status",
              "name": "status",
              "value": "={{ $json.state ?? $json.status }}",
              "type": "string"
            },
            {
              "id": "merge-error-message",
              "name": "error_message",
              "value": "={{ $json.error_message ?? '' }}",
              "type": "string"
            },
            {
              "id": "merge-total-pages",
              "name": "total_pages",
              "value": "={{ $json.total_pages ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-total-regions",
              "name": "total_regions",
              "value": "={{ $json.total_regions ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-total-lines",
              "name": "total_lines",
              "value": "={{ $json.total_lines ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-runtime",
              "name": "runtime",
              "value": "={{ $json.runtime ?? 0 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1920, 200],
      "id": "set-status-context",
      "name": "Merge Status Context"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-terminal-state",
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-not-pending",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2160, 200],
      "id": "if-done",
      "name": "Job finished?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2400, 80],
      "id": "if-success",
      "name": "Success or Failure?"
    },
    {
      "parameters": {
        "fromEmail": "noreply@flow-project.net",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "Preprocessing complete: {{ $json.repo_name }}",
        "emailType": "html",
        "message": "<h2>Preprocessing finished successfully</h2><p>Your PageXML/image export has been preprocessed and uploaded to HuggingFace.</p><ul><li><strong>Repository:</strong> {{ $json.repo_name }}</li><li><strong>Job ID:</strong> {{ $json.process_id }}</li><li><strong>Pages:</strong> {{ $json.total_pages }}</li><li><strong>Regions:</strong> {{ $json.total_regions }}</li><li><strong>Lines:</strong> {{ $json.total_lines }}</li><li><strong>Runtime:</strong> {{ $json.runtime }}s</li></ul><p>You can access the dataset at <a href=\"https://huggingface.co/datasets/{{ $json.repo_name }}\">https://huggingface.co/datasets/{{ $json.repo_name }}</a>.</p><hr><p><small>Sent by the Flow preprocessing pipeline.</small></p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2640, -60],
      "id": "email-success",
      "name": "Email: Success",
      "credentials": {
        "smtp": {
          "id": "SMTP_CRED_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@flow-project.net",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "Preprocessing FAILED: {{ $json.repo_name }}",
        "emailType": "html",
        "message": "<h2>Preprocessing failed</h2><p>Unfortunately your preprocessing job encountered an error.</p><ul><li><strong>Repository:</strong> {{ $json.repo_name }}</li><li><strong>Job ID:</strong> {{ $json.process_id }}</li><li><strong>Status:</strong> {{ $json.status }}</li><li><strong>Error:</strong> {{ $json.error_message }}</li></ul><p>Please check the preprocessing service logs or contact the administrator.</p><hr><p><small>Sent by the Flow preprocessing pipeline.</small></p>",
        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [2640, 220],
      "id": "email-failure",
      "name": "Email: Failure",
      "credentials": {
        "smtp": {
          "id": "SMTP_CRED_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
