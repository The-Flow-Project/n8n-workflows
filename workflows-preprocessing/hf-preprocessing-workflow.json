            },
            {
              "name": "huggingface_token",
              "value": "={{ $json.params.huggingface_token }}"
            },
            {
              "name": "append",
              "value": "={{ $json.params.append === 'true' }}"
            },
            {
              "name": "export_mode",
              "value": "={{ $json.params.export_mode }}"
