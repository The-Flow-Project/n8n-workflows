        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "huggingface_source_repo_name",
              "value": "={{ $json.params.huggingface_source_repo_name }}"
            },
            {
              "name": "huggingface_target_repo_name",
              "value": "={{ $json.params.huggingface_target_repo_name }}"
            },
            {
              "name": "huggingface_target_repo_private",
              "value": "={{ $json.params.huggingface_target_repo_private === 'true' }}"
            },
            {
              "name": "huggingface_token",
              "value": "={{ $json.params.huggingface_token }}"
            },
            {
              "name": "append",
              "value": "={{ $json.params.append === 'true' }}"
            },
            {
              "name": "export_mode",
              "value": "={{ $json.params.export_mode }}"
            },
            {
              "name": "crop",
              "value": "={{ $json.params.crop === 'true' }}"
            },
            {
              "name": "allow_empty_lines",
              "value": "={{ $json.params.allow_empty_lines === 'true' }}"
            },
            {
              "name": "batch_size",
              "value": "={{ parseInt($json.params.batch_size) }}"
            },
            {
              "name": "augmentation_loops",
              "value": "={{ parseInt($json.params.augmentation_loops) }}"
            },
            {
              "name": "min_width_line",
              "value": "={{ parseInt($json.params.min_width_line) }}"
            },
            {
              "name": "min_height_line",
              "value": "={{ parseInt($json.params.min_height_line) }}"
            },
            {
              "name": "split_train_ratio",
              "value": "={{ parseFloat($json.params.split_train_ratio) }}"
            },
            {
              "name": "split_seed",
              "value": "={{ parseInt($json.params.split_seed) }}"
            },
            {
              "name": "split_shuffle",
              "value": "={{ $json.params.split_shuffle === 'true' }}"
            },
            {
              "name": "segment",
              "value": "={{ ['yolo', 'kraken'].includes($json.params.segment) ? $json.params.segment : null }}"
            },
            {
              "name": "segmenter_config",
              "value": "={{ { model_names: $json.params.segmenter_model_names, batch_sizes: parseInt($json.params.segmenter_batch_sizes), load_existing_segmentation: $json.params.load_existing_segmentation === 'true', order_lines: $json.params.order_lines === 'true', baselines: $json.params.baselines === 'true', kraken_linemasks: $json.params.kraken_linemasks === 'true', creator: $json.params.creator } }}"
            }
