{
  "name": "Write RawXML Pipeline",
  "nodes": [
    {
      "parameters": {
        "content": "## RawXML Writing Pipeline\n1. Form or API POSTs JSON to this webhook\n2. Raw XML write API is called at /xml-merge/start\n3. Status is polled every 30s\n4. Email sent on success/failure\n\nThe service merges inference output back into raw PageXML and pushes the result to HuggingFace.",
        "height": 220,
        "width": 460
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        336,
        -256
      ],
      "id": "00007301-8dd6-4d40-a8be-7c1a5791a712",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rawxml-merge-start",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "ignoreBots": true
        }
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        304,
        144
      ],
      "id": "133a19b8-b378-4816-8603-5589d5693b98",
      "name": "Webhook: Receive RawXML Merge Request",
      "webhookId": "rawxml-merge-webhook",
      "credentials": {
        "httpHeaderAuth": {
          "id": "fTo5NQ0AqGDZE5U6",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"status\": \"accepted\", \"message\": \"RawXML merge started. You will receive an email when it is done.\" }",
        "options": {
          "responseCode": 202
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        560,
        -48
      ],
      "id": "ee641d35-8b40-43ea-81f2-3d58773eb8f8",
      "name": "Respond: 202 Accepted"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-params",
              "name": "params",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        560,
        144
      ],
      "id": "a7d889bc-84cf-4e5f-bdf8-7349bfe6e84e",
      "name": "Build RawXML Merge Params"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8001/xml-merge/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "raw_xml_repo",
              "value": "={{ $json.params.raw_xml_repo }}"
            },
            {
              "name": "inference_repo",
              "value": "={{ $json.params.inference_repo }}"
            },
            {
              "name": "huggingface_token",
              "value": "={{ $json.params.huggingface_token }}"
            },
            {
              "name": "output_repo_name",
              "value": "={{ $json.params.output_repo_name }}"
            },
            {
              "name": "private_repo",
              "value": "={{ $json.params.private_repo === true || $json.params.private_repo === 'true' }}"
            },
            {
              "name": "upload_mode",
              "value": "={{ $json.params.upload_mode ?? 'new_repo' }}"
            },
            {
              "name": "allow_source_repo_update",
              "value": "={{ $json.params.allow_source_repo_update === true || $json.params.allow_source_repo_update === 'true' }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        784,
        144
      ],
      "id": "e9297a64-39e6-419d-a49e-9422ea26cbc1",
      "name": "POST: Start RawXML Merge",
      "credentials": {
        "httpHeaderAuth": {
          "id": "fTo5NQ0AqGDZE5U6",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-process-id",
              "name": "process_id",
              "value": "={{ $json.request_id ?? $json.process_id ?? $json.id ?? $json.job_id }}",
              "type": "string"
            },
            {
              "id": "assign-notify-email",
              "name": "notify_email",
              "value": "={{ $('Webhook: Receive RawXML Merge Request').item.json.body.notify_email }}",
              "type": "string"
            },
            {
              "id": "assign-raw-xml-repo",
              "name": "raw_xml_repo",
              "value": "={{ $('Webhook: Receive RawXML Merge Request').item.json.body.raw_xml_repo }}",
              "type": "string"
            },
            {
              "id": "assign-inference-repo",
              "name": "inference_repo",
              "value": "={{ $('Webhook: Receive RawXML Merge Request').item.json.body.inference_repo }}",
              "type": "string"
            },
            {
              "id": "assign-output-repo",
              "name": "output_repo",
              "value": "={{ $('Webhook: Receive RawXML Merge Request').item.json.body.output_repo_name }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1008,
        144
      ],
      "id": "5d23f1c1-dc5f-49cb-b15b-fdb7265488da",
      "name": "Extract Job ID & Email"
    },
    {
      "parameters": {
        "amount": 30
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1232,
        144
      ],
      "id": "7c6249aa-7b1b-4714-a6e9-0b0bd56fe5cb",
      "name": "Wait 30s",
      "webhookId": "638cd781-8111-42ce-8622-ae076f940c2a"
    },
    {
      "parameters": {
        "url": "=http://host.docker.internal:8001/xml-merge/status/{{ $json.process_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1456,
        80
      ],
      "id": "2a3cad4d-3e6b-48b1-b66e-51f4a67453a1",
      "name": "GET: Check Status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "fTo5NQ0AqGDZE5U6",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "merge-process-id",
              "name": "process_id",
              "value": "={{ $('Extract Job ID & Email').item.json.process_id }}",
              "type": "string"
            },
            {
              "id": "merge-notify-email",
              "name": "notify_email",
              "value": "={{ $('Extract Job ID & Email').item.json.notify_email }}",
              "type": "string"
            },
            {
              "id": "merge-raw-xml-repo",
              "name": "raw_xml_repo",
              "value": "={{ $('Extract Job ID & Email').item.json.raw_xml_repo }}",
              "type": "string"
            },
            {
              "id": "merge-inference-repo",
              "name": "inference_repo",
              "value": "={{ $('Extract Job ID & Email').item.json.inference_repo }}",
              "type": "string"
            },
            {
              "id": "merge-output-repo",
              "name": "output_repo",
              "value": "={{ $('Extract Job ID & Email').item.json.output_repo }}",
              "type": "string"
            },
            {
              "id": "merge-status",
              "name": "status",
              "value": "={{ $json.state ?? $json.status }}",
              "type": "string"
            },
            {
              "id": "merge-error-message",
              "name": "error_message",
              "value": "={{ $json.error_message ?? $json.error ?? '' }}",
              "type": "string"
            },
            {
              "id": "merge-runtime",
              "name": "runtime",
              "value": "={{ $json.runtime ?? $json.duration ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-total-items",
              "name": "total_items",
              "value": "={{ $json.total_items ?? $json.total_lines ?? $json.total_pages ?? 0 }}",
              "type": "number"
            },
            {
              "id": "merge-result-url",
              "name": "result_url",
              "value": "={{ $json.result_url ?? ('https://huggingface.co/datasets/' + $('Extract Job ID & Email').item.json.output_repo) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1680,
        80
      ],
      "id": "b7e24ad9-b9ac-4a1b-ac5a-67d653dc6312",
      "name": "Merge Status Context"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-not-in-progress",
              "leftValue": "={{ $json.status }}",
              "rightValue": "in_progress",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-not-pending",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-not-started",
              "leftValue": "={{ $json.status }}",
              "rightValue": "started",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1904,
        144
      ],
      "id": "baba2647-d072-4853-bf74-d530926a9b1b",
      "name": "Job finished?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-success",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2128,
        144
      ],
      "id": "0784eab8-a421-4d13-a271-82dd52da384f",
      "name": "Success or Failure?"
    },
    {
      "parameters": {
        "fromEmail": "noreply@flow-project.net",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "=RawXML merge complete: {{ $json.output_repo || $json.raw_xml_repo }}",
        "emailFormat": "both",
        "text": "=RawXML merge finished successfully\n\nRaw XML dataset: {{ $json.raw_xml_repo }}\nInference dataset: {{ $json.inference_repo }}\nOutput dataset: {{ $json.output_repo }}\nJob ID: {{ $json.process_id }}\nItems processed: {{ $json.total_items }}\nRuntime: {{ $json.runtime }}s\n\nOutput repository: https://huggingface.co/datasets/{{ $json.output_repo }}\n\n----\nSent by the Flow RawXML merge pipeline.",
        "html": "=<h2>RawXML merge finished successfully</h2><ul><li><strong>Raw XML dataset:</strong> {{ $json.raw_xml_repo }}</li><li><strong>Inference dataset:</strong> {{ $json.inference_repo }}</li><li><strong>Output dataset:</strong> {{ $json.output_repo }}</li><li><strong>Job ID:</strong> {{ $json.process_id }}</li><li><strong>Items processed:</strong> {{ $json.total_items }}</li><li><strong>Runtime:</strong> {{ $json.runtime }}s</li></ul><p>Output repository: <a href=\"https://huggingface.co/datasets/{{ $json.output_repo }}\">https://huggingface.co/datasets/{{ $json.output_repo }}</a></p><hr><p><small>Sent by the Flow RawXML merge pipeline.</small></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2352,
        48
      ],
      "id": "c313169d-f4fb-4957-beb4-498e8618595d",
      "name": "Email: Success",
      "webhookId": "0ef87b04-d325-4ac7-85e1-c503451620f4",
      "credentials": {
        "smtp": {
          "id": "SU1oQTKpVo8gu007",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "noreply@flow-project.net",
        "toEmail": "={{ $json.notify_email }}",
        "subject": "=RawXML merge FAILED: {{ $json.output_repo || $json.raw_xml_repo }}",
        "emailFormat": "both",
        "text": "=RawXML merge failed\n\nRaw XML dataset: {{ $json.raw_xml_repo }}\nInference dataset: {{ $json.inference_repo }}\nOutput dataset: {{ $json.output_repo }}\nJob ID: {{ $json.process_id }}\nStatus: {{ $json.status }}\nError: {{ $json.error_message }}\n\nPlease check the RawXML merge service logs.\n\n----\nSent by the Flow RawXML merge pipeline.",
        "html": "=<h2>RawXML merge failed</h2><ul><li><strong>Raw XML dataset:</strong> {{ $json.raw_xml_repo }}</li><li><strong>Inference dataset:</strong> {{ $json.inference_repo }}</li><li><strong>Output dataset:</strong> {{ $json.output_repo }}</li><li><strong>Job ID:</strong> {{ $json.process_id }}</li><li><strong>Status:</strong> {{ $json.status }}</li><li><strong>Error:</strong> {{ $json.error_message }}</li></ul><p>Please check the RawXML merge service logs.</p><hr><p><small>Sent by the Flow RawXML merge pipeline.</small></p>",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2352,
        240
      ],
      "id": "f08859fd-adb2-45e8-b2dc-5d251add352d",
      "name": "Email: Failure",
      "webhookId": "5733b00d-5cc0-4383-9065-f5a4c971174c",
      "credentials": {
        "smtp": {
          "id": "SU1oQTKpVo8gu007",
          "name": "SMTP account"
        }
      }
    }
  ],
